# ============================================================
# MoonBow — Complete Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in the values.
# Variables marked [MOCK OK] are not needed in mock mode —
# the system works without them when DEPENDENCY_MODE=mock.
# Variables marked [REQUIRED] must always be set.
# ============================================================


# ============================================================
# SECTION 1 — LLM (REQUIRED for all phases)
# ============================================================

# The base URL of the LLM API server.
# Current setup uses MiniMax. If you switch to vLLM locally, use:
# LLM_BASE_URL=http://192.168.1.13:8000/v1
LLM_BASE_URL=https://api.minimax.io/v1

# Your MiniMax API key.
# Get it from: https://www.minimax.io → Dashboard → API Keys
LLM_API_KEY=your_minimax_api_key_here

# Model to use. Current: MiniMax-M2.7
# For local vLLM: meta-llama/Llama-3.1-70B-Instruct
LLM_MODEL_NAME=MiniMax-M2.7

# Sampling temperature. 0.0 = deterministic, 1.0 = creative.
# Expander uses this value. Critic always overrides to 0.1 internally.
LLM_TEMPERATURE=0.3

# Max tokens the LLM can return per call.
LLM_MAX_TOKENS=190000


# ============================================================
# SECTION 2 — Pipeline Behaviour (REQUIRED)
# ============================================================

# Switch between mock (no infrastructure) and real (full stack).
# mock = runs locally with local files, no DB or MinIO needed.
# real = all MCP servers must be running and configured below.
DEPENDENCY_MODE=real

# Max expander-critic loop iterations in Phase 1 before force-pass.
MAX_ITERATIONS=3


# ============================================================
# SECTION 3 — PostgreSQL (MOCK OK — only needed when DEPENDENCY_MODE=real)
# ============================================================
# This is the central state store. Every phase reads and writes here.
# Set up a PostgreSQL instance and create the moonbow database.
#
# How to get these values:
#   - If running locally:   host=localhost, user/password = whatever you set during psql setup
#   - If on a server/VM:    host = VM's IP or domain, use the DB credentials from that server
#   - If using Supabase/Neon/RDS: copy the connection string and break it into these fields

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=moonbow
POSTGRES_USER=moonbow_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_POOL_SIZE=5


# ============================================================
# SECTION 4 — MinIO / File System (MOCK OK — only needed when DEPENDENCY_MODE=real)
# ============================================================
# MinIO is S3-compatible object storage. Stores curriculum files,
# skill MD files, generated PPTXs, and notes PDFs.
#
# How to get these values:
#   - If running MinIO locally (Docker):
#       docker run -p 9000:9000 -p 9001:9001 \
#         -e MINIO_ROOT_USER=minioadmin \
#         -e MINIO_ROOT_PASSWORD=minioadmin \
#         quay.io/minio/minio server /data --console-address ":9001"
#       Then: endpoint=http://localhost:9000, key=minioadmin, secret=minioadmin
#   - If using MinIO on a server: use that server's IP + the credentials set there
#   - If using AWS S3 instead: endpoint=https://s3.amazonaws.com, key=AWS access key,
#       secret=AWS secret key (get from IAM → Users → Security credentials)

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Bucket names — create these in MinIO console (http://localhost:9001)
# or via: mc mb myminio/curricula  (using MinIO Client CLI)
CURRICULUM_BUCKET=curricula
SKILLS_BUCKET=skills
OUTPUT_BUCKET=generated-content


# ============================================================
# SECTION 5 — Qdrant (MOCK OK — only needed when DEPENDENCY_MODE=real)
# ============================================================
# Qdrant is the vector database for cross-curriculum similarity search.
# Used by Phase 1's Expander to avoid duplicating prerequisite content.
# Phase 1 works fine without this — empty results are handled gracefully.
#
# How to get these values:
#   - If running Qdrant locally (Docker):
#       docker run -p 6333:6333 qdrant/qdrant
#       Then: host=localhost, port=6333, api_key=leave blank
#   - If using Qdrant Cloud (https://cloud.qdrant.io):
#       Create a cluster → get the cluster URL and API key from the dashboard
#       Set QDRANT_HOST to just the hostname (no https://)
#       Set QDRANT_API_KEY to the key shown in the dashboard

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=course_topics

# Embedding model name (from HuggingFace sentence-transformers).
# Must match the model used when topics were first indexed into Qdrant.
# Don't change this mid-project or all existing vectors become incompatible.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Minimum similarity score to return a result (0.0–1.0).
# 0.75 means at least 75% similar. Lower = more (noisier) results.
QDRANT_SIMILARITY_THRESHOLD=0.75


# ============================================================
# SECTION 6 — Reference Database (MOCK OK — only needed when DEPENDENCY_MODE=real)
# ============================================================
# Internal DB of accreditation standards and benchmark curricula.
# Used by Phase 2's Relevance Evaluator and Phase 3's CO agent.
# Can be a separate PostgreSQL database or a schema in the main moonbow DB.
#
# How to get these values:
#   - Same PostgreSQL instance as the main DB but different database name
#   - Or same DB, different schema (adjust server.py accordingly)
#   - Data loading: manually curated NBA/NAAC standards + scraped NPTEL/MIT curricula

REFDB_HOST=localhost
REFDB_PORT=5432
REFDB_NAME=moonbow_refdb
REFDB_USER=refdb_user
REFDB_PASSWORD=your_refdb_password_here


# ============================================================
# SECTION 7 — Document Generation (MOCK OK — only needed when DEPENDENCY_MODE=real)
# ============================================================
# Paths to slide and notes templates used for rendering PPTX and PDF files.
# Phase 5a uses PPTX_TEMPLATE_PATH, Phase 5b uses NOTES_TEMPLATE_PATH.
#
# How to get these:
#   - PPTX: Create a .pptx file with the desired slide layout/theme in PowerPoint or LibreOffice.
#     Save it to the repo (e.g. assets/templates/slide_template.pptx) and point here.
#   - NOTES: Create a pandoc or LaTeX template file for notes PDF formatting.
#   - Leave blank to use default python-pptx blank template.
#   - DOC_GEN_STAGING_DIR: local temp dir for in-progress renders before MinIO upload.

PPTX_TEMPLATE_PATH=
NOTES_TEMPLATE_PATH=
DOC_GEN_STAGING_DIR=/tmp/moonbow_docgen


# ============================================================
# SECTION 8 — Quality / Plagiarism (MOCK OK — only needed when DEPENDENCY_MODE=real)
# ============================================================
# Used by Phase 5b's QA gate to check content originality.
# Quality threshold and originality threshold control what counts as a pass.
#
# How to get PLAGIARISM_API_KEY:
#   - Option A: Copyleaks → https://copyleaks.com → Sign up → API → Get Key
#   - Option B: PlagScan  → https://www.plagscan.com → API credentials
#   - Option C: Build custom fingerprinting (no external key needed — see server.py TODO)
# If left blank, the originality check is skipped with a warning logged.

QUALITY_THRESHOLD=0.80
ORIGINALITY_THRESHOLD=0.85
PLAGIARISM_API_URL=
PLAGIARISM_API_KEY=
